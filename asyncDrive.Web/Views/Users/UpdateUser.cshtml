@model asyncDrive.Web.Models.DTO.UpdateUserDto

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4" style="width: 100%;">
        <h3 class="text-left mb-4">Update User</h3>

<form asp-action="UpdateUser" method="post">
    <div class="form-group">
        <label asp-for="UserName"></label>
        <input asp-for="UserName" class="form-control" />
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success mt-2">Update User</button>
</form>

<a class="btn btn-secondary mt-2" asp-controller="Users" asp-action="AllUsers">Back to Users</a>
    </div></div>     