@model IEnumerable<asyncDrive.Web.Models.DTO.UserDto>
<script>
    // if (sessionStorage.getItem("AccessToken")) {
    //     debugger;
    //     document.getElementById("userConfigDropdown").parentElement.style.display = "block";
    // }
</script>
<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4" style="width: 100%;">
        <h3 class="text-left mb-4"> <a class="btn btn-success" asp-controller="Users" asp-action="CreateUser">Create User</a></h3>


                <div class="mb-3">
                   
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>@user.UserName</td>
                                <td>
                                    <a class="btn btn-primary" asp-controller="Users" asp-action="UserDetails" asp-route-userId="@user.Id">Details</a>
                                    <a class="btn btn-warning" asp-controller="Users" asp-action="UpdateUser" asp-route-userId="@user.Id">Edit</a>
                                    <a class="btn btn-danger" asp-controller="Users" asp-action="DeleteUserConfirmation" asp-route-userId="@user.Id">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

          </div></div>